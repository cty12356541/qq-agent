# ==============================================================================
# qq-agent 环境变量示例模板
# 使用方式：复制本文件为 .env（已入 .gitignore），填入本地真实配置；严禁提交任何真实密钥或 QQ 号！
# ==============================================================================

# --- 1. QQ 账号与群聊白名单 ---
# 机器人专用小号 QQ 号（纯数字，同时供 NapCat 容器可选预填账号与 @bot 识别使用）
QQ_BOT_ID=
# 管理员 QQ 号白名单（逗号分隔，可执行不经 LLM 的管理命令，如 /quota、/reset、/reload、/persona、/stop 等）
QQ_ADMIN_IDS=
# 允许响应的测试群/目标群号白名单（逗号分隔；留空按应用默认白名单策略处理）
QQ_ALLOWED_GROUPS=

# --- 2. NapCat OneBot v11 WebSocket 接入（仅本机回环） ---
NAPCAT_WS_URL=ws://127.0.0.1:3001
# NapCat 正向 WS 可选鉴权 Token（若在 NapCat WebUI 配置了 Token，请在此保持一致）
NAPCAT_ACCESS_TOKEN=

# --- 3. 主循环（快脑·社交人格层）LLM Provider 配置 ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 软限降级或轻量判断用的便宜模型（留空则回退使用 LLM_MODEL）
LLM_CHEAP_MODEL=
# 日常闲聊默认关闭深度思考以降低延迟与 Token 消耗（false 关闭 / true 开启）
LLM_ENABLE_THINKING=false
# 是否启用入站图片/表情包多模态视觉识别（需模型支持多模态，如 glm-5.3-flash）
QQ_ENABLE_VISION=true

# --- 4. 快慢双脑 · 深度=1 异步后台子 Agent 与联网搜索配置 ---
QQ_AGENT_MAX_STEPS=3
QQ_AGENT_TURN_TIMEOUT_S=35.0
QQ_BUBBLE_TYPING_DELAY_S=0.45
SUBAGENT_ENABLED=true
# 后台深查子 Agent 模型（留空则复用 LLM_MODEL）
SUBAGENT_MODEL=
# 后台子 Agent 是否开启深度思考（主循环关闭思考保网感，子 Agent 可开启思考提升多源查证质量）
SUBAGENT_ENABLE_THINKING=true
SUBAGENT_MAX_STEPS=4
SUBAGENT_TIMEOUT_S=30.0
SUBAGENT_MAX_CONCURRENT=2
# 免 Key 多源联网搜索（内置 Bing CN + DuckDuckGo HTML；可选配置外部 Tavily/Bocha API Key）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_S=8.0
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

# --- 5. llmos 运行时与多进程解耦配置（DOGFOOD-FULL 模式） ---
# llmos 源码与预构建 daemon 根目录（严格只读）
LLMOS_ROOT=D:\llmos
# 若外部已常驻启动 system-control-daemon，可显式指定其 plain_socket 端点；留空则由 supervisor 自动托管并共享
LLMOS_PLAIN_ENDPOINT=
# 运行角色：supervisor（默认：拉起独立 daemon + adapter + brain 三进程）| adapter | brain | all-in-one
QQ_RUNTIME_ROLE=supervisor

# --- 6. 本地存储、多层人设覆盖与表情包参数 ---
QQ_DATA_DIR=data
QQ_PERSONA_PATH=config/persona.default.toml
# 本地私有人设覆盖层与多档案目录（默认分别指向 <QQ_DATA_DIR>/persona.local.toml 与 <QQ_DATA_DIR>/personas）
QQ_PERSONA_LOCAL_PATH=
QQ_PERSONAS_DIR=
QQ_STICKERS_MANIFEST=config/stickers.toml

# --- 7. 输入防抖合批与高活跃群聊触发参数 ---
QQ_PRIVATE_DEBOUNCE_S=1.8
QQ_GROUP_DEBOUNCE_S=1.2
QQ_GROUP_FOLLOWUP_WINDOW_S=60.0
QQ_GROUP_PROACTIVE_PROB=0.22
QQ_GROUP_TOPIC_PROB=0.65
QQ_GROUP_PROACTIVE_EVERY_N=6
QQ_GROUP_PROACTIVE_COOLDOWN_S=12.0

# --- 8. 花费护栏与容器运行可选参数 ---
QQ_DAILY_MAX_CALLS=200
QQ_DAILY_MAX_TOKENS=200000
QQ_DAILY_SOFT_COST_MICROS_USD=1000000
QQ_DAILY_HARD_COST_MICROS_USD=2000000
TZ=Asia/Shanghai
NAPCAT_UID=1000
NAPCAT_GID=1000
