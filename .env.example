# ==============================================================================
# qq-agent 环境变量示例模板
# 使用方式：复制本文件为 .env（已入 .gitignore），填入本地真实配置；严禁提交任何真实密钥或 QQ 号！
# ==============================================================================

# --- 1. QQ 账号与群聊白名单 ---
# 机器人专用小号 QQ 号（纯数字，同时供 NapCat 容器可选预填账号与 @bot 识别使用）
QQ_BOT_ID=
# 管理员 QQ 号白名单（逗号分隔，可执行不经 LLM 的管理命令，如 /status、/reset 等）
QQ_ADMIN_IDS=
# 允许响应的测试群/目标群号白名单（逗号分隔；留空按应用默认白名单策略处理）
QQ_ALLOWED_GROUPS=

# --- 2. NapCat OneBot v11 WebSocket 接入（仅本机回环） ---
NAPCAT_WS_URL=ws://127.0.0.1:3001
# NapCat 正向 WS 可选鉴权 Token（若在 NapCat WebUI 配置了 Token，请在此保持一致）
NAPCAT_ACCESS_TOKEN=

# --- 3. LLM Provider 配置（默认 OpenAI-Compatible / DeepSeek） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 软限降级或轻量判断用的便宜模型（留空则回退使用 LLM_MODEL）
LLM_CHEAP_MODEL=

# --- 4. llmos 运行时与 ChannelControl SABI v1.0 配置（DOGFOOD-FULL 模式） ---
# llmos 源码与预构建 daemon 根目录
LLMOS_ROOT=D:\llmos
# 若外部已常驻启动 system-control-daemon，可显式指定其 plain_socket 端点；留空则由运行时托管或自动推导
LLMOS_PLAIN_ENDPOINT=

# --- 5. 本地存储、护栏与容器运行可选参数 ---
QQ_DATA_DIR=data
QQ_DAILY_MAX_CALLS=200
QQ_DAILY_MAX_TOKENS=200000
QQ_DAILY_SOFT_COST_MICROS_USD=1000000
QQ_DAILY_HARD_COST_MICROS_USD=2000000
TZ=Asia/Shanghai
NAPCAT_UID=1000
NAPCAT_GID=1000
